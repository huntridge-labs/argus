{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "regex"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies",
    "automated"
  ],
  "commitMessagePrefix": "chore(deps):",
  "schedule": [
    "before 9am on Monday"
  ],
  "timezone": "America/New_York",
  "regexManagers": [
    {
      "description": "Container image tags in argus/containers.py",
      "fileMatch": [
        "argus/containers\\.py"
      ],
      "matchStrings": [
        "\"(?<depName>[a-z0-9./-]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Tool versions pinned in GitHub Actions (TOOL_VERSION= pattern)",
      "fileMatch": [
        "\\.github/actions/.+/action\\.yml"
      ],
      "matchStrings": [
        "(?<depName>OPENGREP)_VERSION[=:]\\s*['\"]?(?<currentValue>[\\d.]+)['\"]?",
        "(?<depName>ACTIONLINT)_VERSION[=:]\\s*['\"]?(?<currentValue>[\\d.]+)['\"]?",
        "(?<depName>ZIZMOR)_VERSION[=:]\\s*['\"]?(?<currentValue>[\\d.]+)['\"]?"
      ],
      "datasourceTemplate": "github-releases",
      "lookupNameTemplate": "{{#if (equals depName 'OPENGREP')}}opengrep/opengrep{{/if}}{{#if (equals depName 'ACTIONLINT')}}rhysd/actionlint{{/if}}{{#if (equals depName 'ZIZMOR')}}woodruffw/zizmor{{/if}}"
    },
    {
      "description": "Tool versions in custom Dockerfiles",
      "fileMatch": [
        "docker/Dockerfile\\..+"
      ],
      "matchStrings": [
        "ARG (?<depName>OPENGREP)_VERSION=(?<currentValue>[\\d.]+)",
        "ARG (?<depName>ACTIONLINT)_VERSION=(?<currentValue>[\\d.]+)",
        "ARG (?<depName>ZIZMOR)_VERSION=(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "lookupNameTemplate": "{{#if (equals depName 'OPENGREP')}}opengrep/opengrep{{/if}}{{#if (equals depName 'ACTIONLINT')}}rhysd/actionlint{{/if}}{{#if (equals depName 'ZIZMOR')}}woodruffw/zizmor{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group all container image updates",
      "matchManagers": [
        "regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "groupName": "container-images",
      "automerge": false
    },
    {
      "description": "Group all tool version updates",
      "matchManagers": [
        "regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "groupName": "tool-versions",
      "automerge": false
    }
  ]
}
