# Supply-chain hardening: reject newly-published versions for 24 hours.
# Mitigates the "publish malicious, yank within minutes" attack pattern
# (compromised maintainer accounts, typosquats). Argus — a supply-chain
# security tool — walks the talk on this.
#
# Honored by pnpm 9.4+ for both direct and transitive resolutions.
# Set to 1440 minutes = 24 hours.
minimum-release-age=1440
