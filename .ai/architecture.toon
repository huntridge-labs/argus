# AUTO-GENERATED by AICaC — do not edit. Source: .ai/architecture.yaml
version: "1.0"
dual_implementation:
  description: This project maintains two parallel implementations
  default_assumption: v2_production
  v2_production:
    location: .github/workflows/
    pattern: Reusable workflows
    tag: @v2.12.0
    status: production
    limitation: Requires github.com (cross-repo calls)
    when_to_use: Default for github.com users
  v3_development:
    location: .github/actions/
    pattern: Composite actions
    tag: @v3 (future)
    status: in-development
    advantage: "GHES compatible, self-contained"
    when_to_use: GHES without github.com access
components[6]:
  - name: main-orchestrator
    location: .github/workflows/reusable-security-hardening.yml
    purpose: Single entry point that dispatches to individual scanners
    type: entrypoint
    accepts: scanners parameter (comma-separated list or 'all')
    returns: "Aggregated SARIF, PR comments, job summaries"
    calls[1]: scanner-workflows
  - name: scanner-workflows
    location: .github/workflows/scanner-*.yml
    purpose: Individual scanner wrappers with consistent interface
    type: workflow
    pattern: Run scanner → Parse output → Generate summary → Upload SARIF
    instances[12]: scanner-codeql.yml,scanner-bandit.yml,scanner-gitleaks.yml,scanner-opengrep.yml,scanner-trivy.yml,scanner-grype.yml,scanner-syft.yml,scanner-checkov.yml,scanner-clamav.yml,scanner-zap.yml,scanner-osv.yml,scanner-dependency-review.yml
  - name: composite-actions
    location: .github/actions/scanner-*/
    purpose: Self-contained scanner actions (v3.0)
    type: action
    structure:
      action.yml: "Inputs, outputs, steps"
      "scripts/parse-results.py": Scanner output → JSON
      "scripts/generate-summary.py": JSON → Markdown
      "tests/": Co-located pytest tests
    pr_commenting:
      has_step: true
      default: false
      condition: github.event_name == 'pull_request' && inputs.post_pr_comment == 'true'
      uses: .github/actions/comment-pr/action.yml
      purpose: Allows standalone scanner usage with individual PR comments
  - name: config-parsers
    location: .github/actions/parse-*/
    purpose: Convert YAML/JSON configs to GitHub Actions matrix
    type: utility
    outputs: JSON array for matrix strategy
    instances[2]: parse-container-config,parse-zap-config
  - name: summary-generators
    location: .github/actions/*-summary/
    purpose: Aggregate results into unified summaries
    type: utility
    instances[2]: security-summary,linting-summary
  - name: scn-detector
    location: .github/actions/scn-detector/
    purpose: FedRAMP Significant Change Notification detection and classification
    type: compliance-action
    description: Analyzes IaC changes and classifies them per FedRAMP 20X SCN guidelines
    classification_method: Hybrid (rule-based + multi-provider AI fallback)
    supported_formats[3]: terraform,kubernetes,cloudformation
    ai_providers:
      supported[2]: anthropic,openai
      default: anthropic
      configurable_via: ai_fallback section in scn-config.yml
      env_vars:
        anthropic: ANTHROPIC_API_KEY
        openai: OPENAI_API_KEY
      features[3]: SDK-first with raw HTTP fallback,"Custom base URL for OpenAI-compatible APIs (Azure, Ollama)","Configurable model, confidence threshold, max tokens"
    structure:
      action.yml: Composite action with 12 steps (includes config validation)
      "schemas/scn-config.schema.json": JSON Schema draft-07 for SCN config validation
      "scripts/analyze_iac_changes.py": Git diff → IaC change extraction
      "scripts/classify_changes.py": Rule-based + AI classification engine (validates config on load)
      "scripts/validate_scn_config.py": "Config validator (dict-based, no jsonschema dependency)"
      "scripts/ai_classifier.py": AI classification orchestrator (provider-agnostic)
      "scripts/ai_providers.py": "Provider abstraction (Anthropic, OpenAI)"
      "scripts/generate_scn_report.py": Markdown + JSON report generation
      "scripts/create_scn_issue.py": GitHub Issue creator with timelines
      "tests/": pytest test suite with 80%+ coverage
    outputs[3]: PR comments with collapsible SCN analysis,GitHub Issues with compliance timelines,JSON audit trail (90-day retention)
    categories:
      routine: No notification required
      adaptive: Within 10 business days after
      transformative: 30 days initial + 10 days final + after
      impact: New assessment required
scanners:
  sast[3]:
    - name: codeql
      purpose: Multi-language semantic code analysis
      languages[10]: python,javascript,typescript,go,java,cpp,ruby,csharp,swift,kotlin
    - name: bandit
      purpose: Python-specific security linter
      languages[1]: python
    - name: opengrep
      purpose: Pattern-based multi-language scanning
      languages[1]: multi
  secrets[1]{name,purpose,output}:
    gitleaks,Git history and file secrets detection,SARIF
  container[3]{name,purpose,output}:
    trivy,Container vulnerability scanning,SARIF
    grype,Container vulnerability scanning (alternative),SARIF
    syft,SBOM generation,SPDX/CycloneDX
  infrastructure[2]{name,purpose,output}:
    trivy-iac,"Terraform, Kubernetes, CloudFormation scanning",SARIF
    checkov,IaC policy-as-code scanning,SARIF
  dependencies[2]{name,purpose,output,note}:
    osv,Dependency vulnerability scanning via OSV database,JSON/SARIF,"Any trigger, uses official google/osv-scanner-action Docker image"
    dependency-review,PR dependency diff analysis and license compliance,JSON,"PR-only, graceful skip on non-PR events"
  malware[1]{name,purpose,output}:
    clamav,File-based malware detection,text
  dast[1]{name,purpose,output}:
    zap,Dynamic web application testing,SARIF
  compliance[1]:
    - name: scn-detector
      purpose: FedRAMP Significant Change Notification detection and classification
      output: "JSON, Markdown, GitHub Issues"
      categories[4]: routine,adaptive,transformative,impact
dependencies:
  external:
    trivy:
      purpose: CVE scanning for OS packages and containers
      why_chosen: "Better GHES integration, SBOM support, active maintenance"
      alternatives_considered[2]: grype,clair
      critical: true
    gitleaks:
      purpose: Secrets detection in git history
      why_chosen: "Fast, accurate, configurable rules"
      alternatives_considered[2]: trufflehog,detect-secrets
      critical: true
    codeql:
      purpose: Semantic code analysis
      why_chosen: "GitHub native, deep analysis, free for public repos"
      limitation: Requires GitHub Advanced Security for private repos
    "osv-scanner":
      purpose: Dependency vulnerability scanning via OSV database
      why_chosen: "Official Docker action from ghcr.io, comprehensive OSV database, any-trigger support"
      alternatives_considered[3]: snyk,npm-audit,pip-audit
      critical: true
    "dependency-review-action":
      purpose: PR-based dependency diff analysis and license compliance
      why_chosen: "GitHub-native, license checking, PR diff comparison"
      limitation: PR-only (requires pull_request event context)
  internal:
    pyyaml:
      purpose: YAML parsing in Python scripts
      required_by[1]: config parsers
    jsonschema:
      purpose: JSON schema validation in Python scripts
      required_by[1]: config validators
    pytest:
      purpose: Testing framework
      required_by[1]: all test suites
    "pytest-cov":
      purpose: Code coverage measurement
      required_by[1]: coverage reporting
data_flow:
  diagram: "User workflow\n  → reusable-security-hardening.yml (dispatcher)\n    → scanner-{name}.yml (parallel matrix)\n      → Run scanner binary\n      → Parse output (→ JSON)\n      → Generate summary (→ Markdown)\n      → Upload SARIF (→ GitHub Security tab)\n      → [Optional] Post individual PR comment (if post_pr_comment: true)\n    → Aggregate results in security-summary\n  → Single comprehensive PR comment (in reusable workflows)\n"
  pr_commenting_strategy:
    description: Flexible PR commenting architecture supporting both standalone and aggregated usage
    standalone_scanner:
      when: Individual scanner action/workflow used directly
      behavior: Each scanner can post its own PR comment
      control: "Set post_pr_comment: true in action inputs"
      use_case: "Single scanner workflows, focused scanning"
      example: "- uses: huntridge-labs/argus/.github/actions/scanner-bandit@0.5.0\n  with:\n    post_pr_comment: true  # Posts individual Bandit PR comment\n"
    reusable_workflow:
      when: Using reusable-security-hardening.yml with multiple scanners
      behavior: "All individual scanners have post_pr_comment: false, only security-summary posts"
      control: "post_pr_comment: false set in reusable-security-hardening.yml for all scanner jobs"
      use_case: "Multiple scanners, unified reporting"
      benefit: Single comprehensive PR comment instead of spam from each scanner
      mechanism: "1. All scanner actions generate markdown summaries\n2. security-summary job downloads all summaries\n3. Combines into security-hardening-report.md\n4. Posts single PR comment with all results\n"
      example: "uses: huntridge-labs/argus/.github/workflows/reusable-security-hardening.yml@0.5.0\nwith:\n  scanners: all\n  post_pr_comment: true  # Only security-summary posts, not individual scanners\n"
    implementation:
      comment_action: .github/actions/comment-pr/action.yml
      deduplication: "Uses HTML comment markers (e.g., opengrep-comment-marker)"
      update_behavior: "Updates existing comment if marker found, creates new otherwise"
      default: post_pr_comment defaults to 'false' in all scanner actions
  stages[6]:
    - name: dispatch
      from: user-workflow
      to: main-orchestrator
      data: "scanners list, configuration"
    - name: parallel-scan
      from: main-orchestrator
      to: scanner-workflows
      data: individual scanner config
      parallel: true
    - name: parse
      from: scanner-binary
      to: parse-script
      data: raw scanner output
    - name: summarize
      from: parse-script
      to: summary-script
      data: structured JSON
    - name: upload
      from: scanner-workflow
      to: github-security-tab
      data: SARIF file
    - name: aggregate
      from: all-scanners
      to: security-summary
      data: all findings
directory_structure:
  ".github/actions/": v3.0 composite actions
  ".github/workflows/": v2.x reusable workflows
  ".github/actions/*/schemas/": JSON schemas co-located with each action
  "examples/workflows/": User-facing workflow examples
  "examples/configs/": Configuration file examples
  "tests/": Test infrastructure
  "tests/fixtures/": Shared test data
  "docs/": Detailed documentation
  "hardening-dagger/": Python reporting utility (separate module)
constraints:
  technical[4]: SARIF files must be < 10MB for GitHub upload,Matrix jobs limited to 256 per workflow,"Composite actions can't use services: or container:",GHES versions vary - can't assume latest features
  organizational[2]: Must support air-gapped environments (no external API calls),"License: AGPL-3.0 (copyleft implications)"