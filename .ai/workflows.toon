# AUTO-GENERATED by AICaC — do not edit. Source: .ai/workflows.yaml
version: "1.0"
user_workflows:
  basic_security_scan:
    description: Run all security scanners on a repository
    category: scanning
    code: "# .github/workflows/security.yml\nname: Security Scan\non: [push, pull_request]\n\njobs:\n  security:\n    uses: huntridge-labs/argus/.github/workflows/reusable-security-hardening.yml@0.5.0\n    with:\n      scanners: all\n      enable_code_security: true\n      fail_on_severity: high\n    secrets:\n      github_token: ${{ secrets.GITHUB_TOKEN }}\n"
    requirements[1]: GitHub Advanced Security enabled (for SARIF upload)
    permissions_needed[2]: "security-events: write","contents: read"
  fast_sast_only:
    description: Quick SAST scan for rapid feedback on push events
    category: scanning
    when_to_use: "Push events, rapid iteration, development branches"
    code: "uses: huntridge-labs/argus/.github/workflows/reusable-security-hardening.yml@0.5.0\nwith:\n  scanners: codeql,bandit,gitleaks,opengrep\n  fail_on_severity: high\n  enable_code_security: true\nsecrets:\n  github_token: ${{ secrets.GITHUB_TOKEN }}\n"
  container_scanning:
    description: Scan container images defined in config file
    category: scanning
    code: "uses: huntridge-labs/argus/.github/workflows/container-scan-from-config.yml@0.5.0\nwith:\n  config_file: .github/container-config.yml\nsecrets:\n  github_token: ${{ secrets.GITHUB_TOKEN }}\n"
    requires_config: .github/container-config.yml
    config_example: "version: \"1.0\"\ncontainers:\n  - name: app-frontend\n    registry: ghcr.io\n    image: org/frontend\n    tag: latest\n    scanners: [trivy, grype]\n  - name: app-backend\n    registry: docker.io\n    image: org/backend\n    tag: v1.2.3\n    scanners: [trivy, syft]\n"
  individual_scanner_v3:
    description: Use single scanner via composite action (v3.0)
    category: scanning
    code: "- uses: huntridge-labs/argus/.github/actions/scanner-bandit@0.5.0\n  with:\n    path: src/\n    fail_on_severity: high\n    enable_sarif_upload: true\n"
    note: "v3.0 - currently on feature branch, not yet released to main"
  dependency_scanning:
    description: Scan dependencies for known vulnerabilities and license compliance
    category: scanning
    when_to_use: Any event (OSV) or pull requests (dependency-review)
    code: "uses: huntridge-labs/argus/.github/workflows/reusable-security-hardening.yml@0.5.0\nwith:\n  scanners: dependencies\n  fail_on_severity: high\n  enable_code_security: true\n"
    note: 'dependencies' enables both osv and dependency-review scanners
  infrastructure_scanning:
    description: "Scan Terraform, Kubernetes, CloudFormation"
    category: scanning
    code: "uses: huntridge-labs/argus/.github/workflows/infrastructure-scan.yml@0.5.0\nwith:\n  path: terraform/\n  scanners: trivy-iac,checkov\n  fail_on_severity: high\n"
  fedramp_scn_detection:
    description: FedRAMP Significant Change Notification detection and tracking
    category: compliance
    when_to_use: "FedRAMP-authorized systems, compliance-required IaC changes"
    code: "name: FedRAMP SCN Detection\non:\n  pull_request:\n    paths:\n      - 'terraform/**'\n      - 'kubernetes/**'\n      - 'cloudformation/**'\n\npermissions:\n  contents: read\n  pull-requests: write\n  issues: write\n\njobs:\n  scn-detection:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0  # Required for git diff\n\n      - uses: huntridge-labs/argus/.github/actions/scn-detector@0.5.0\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}\n        with:\n          config_file: '.github/scn-config.yml'\n          create_issues: true\n          post_pr_comment: true\n          enable_ai_fallback: true\n"
    requirements[2]: .github/scn-config.yml configuration file,"ANTHROPIC_API_KEY secret (optional, for AI fallback)"
    outputs[3]: PR comment with SCN analysis,GitHub Issues for Adaptive/Transformative/Impact changes,JSON audit trail (90-day retention)
    config_example: "# .github/scn-config.yml\nversion: \"1.0\"\nrules:\n  routine:\n    - pattern: \"tags.*\"\n  adaptive:\n    - resource: \"aws_ami.*\"\n      operation: \"modify\"\n  transformative:\n    - resource: \"aws_rds_.*\\\\.engine\"\n      operation: \"modify\"\n  impact:\n    - attribute: \".*encryption.*\"\n      operation: \"delete|modify\"\n"
  scheduled_full_scan:
    description: Nightly comprehensive security scan
    category: scanning
    code: "name: Nightly Security Scan\non:\n  schedule:\n    - cron: '0 2 * * *'  # 2 AM UTC daily\n\njobs:\n  security:\n    uses: huntridge-labs/argus/.github/workflows/reusable-security-hardening.yml@0.5.0\n    with:\n      scanners: all\n      fail_on_severity: none  # Report only, don't fail\n      enable_code_security: true\n"
contributor_workflows:
  run_tests:
    description: Execute the full test suite
    command: pytest
    breakdown:
      all: pytest
      fast: pytest --no-cov -q
      coverage: pytest --cov
    coverage_targets:
      overall: 80%
  local_development:
    description: Set up local development environment
    steps[3]{action,command}:
      Clone repository,git clone <repo-url> && cd argus
      Install Python dependencies,pip install -r requirements.txt
      Run tests to verify setup,pytest
    alternative: Use Dev Container (recommended)
    devcontainer_steps[4]: Open in VS Code,Command Palette → 'Reopen in Container',Wait for container build,"Run: pytest"
  add_new_scanner:
    description: Add support for a new security scanner
    steps[7]:
      - action: Create action directory
        command: "mkdir -p .github/actions/scanner-{name}"
      - action: Create action.yml
        location: ".github/actions/scanner-{name}/action.yml"
        template: .github/actions/scanner-bandit/action.yml
      - action: Create parse script
        location: ".github/actions/scanner-{name}/scripts/parse-results.py"
        purpose: Convert scanner output → JSON
      - action: Create summary script
        location: ".github/actions/scanner-{name}/scripts/generate-summary.py"
        purpose: Convert JSON → Markdown summary
      - action: Add tests
        location: ".github/actions/scanner-{name}/tests/"
        required_files[2]: test_parse_results.py,test_generate_summary.py
      - action: Update orchestrator
        file: .github/workflows/reusable-security-hardening.yml
        pattern: Add to scanner matrix
      - action: Document
        file: docs/scanners.md
        pattern: Add scanner reference
    reference_implementation: .github/actions/scanner-bandit/
    contributing_guide: CONTRIBUTING.md
  create_release:
    description: Release a new version
    command: npm run release
    options:
      patch: "npm run release:patch"
      minor: "npm run release:minor"
      major: "npm run release:major"
    prerequisites[3]: All tests passing,On main branch,Clean working directory
    what_happens[6]: Bumps version in version.yaml,Updates version in all docs and examples,Generates CHANGELOG entry,Creates git tag,Pushes to remote,Creates GitHub release
  run_single_action_test:
    description: Test a specific action locally
    command: "cd .github/actions/scanner-{name} && ./tests/test-parse.sh"
  validate_schemas:
    description: Validate config files against JSON schemas
    command: "npm run test:unit"
testing:
  unit_tests:
    command: pytest
    coverage_requirement: 80%
    what_it_tests: "Parser and summary script behavior, JSON schema validation"
  integration_tests:
    location: .github/workflows/test-actions.yml
    trigger: Push to PR branch
    what_it_tests: Full action execution in GitHub Actions environment
  local_scanner_test:
    description: Test scanner locally before pushing
    steps[4]: "Install scanner binary (e.g., trivy, bandit)",Run scanner on test fixtures,Pipe output through parse script,Verify JSON structure
    example: "bandit -r tests/fixtures/test-apps/python-app -f json | python .github/actions/scanner-bandit/scripts/parse-results.py counts -\n"
quick_reference:
  test_all: pytest
  test_fast: pytest --no-cov -q
  test_with_coverage: pytest --cov
  lint: npm run lint
  release: npm run release
  format: npm run format