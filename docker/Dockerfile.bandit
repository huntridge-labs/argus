FROM python:3.13-alpine AS base

LABEL org.opencontainers.image.source="https://github.com/huntridge-labs/argus"
LABEL org.opencontainers.image.description="Argus Bandit Python SAST Scanner"
LABEL org.opencontainers.image.licenses="AGPL-3.0"

# Patch OS-level vulnerabilities before anything else
RUN apk upgrade --no-cache

ARG BANDIT_VERSION=1.9.4

RUN adduser -D -u 1000 argus
RUN pip install --no-cache-dir "bandit[toml,sarif]==${BANDIT_VERSION}"

USER argus
WORKDIR /workspace
ENTRYPOINT ["bandit"]
