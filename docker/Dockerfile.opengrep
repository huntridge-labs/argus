FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS builder

ARG OPENGREP_VERSION=1.32.0
ARG TARGETARCH

# Fetch to a temp file with retries (transient GitHub 5xx/timeout/conn-reset are
# retried; a 404 still fails fast), then install only on a complete download. See #320.
RUN apk add --no-cache curl && \
    if [ "$TARGETARCH" = "arm64" ]; then \
      ARCH="aarch64"; \
    else \
      ARCH="x86"; \
    fi && \
    curl -fsSL --retry 5 --retry-delay 2 --retry-connrefused --connect-timeout 10 \
      -o /tmp/opengrep \
      "https://github.com/opengrep/opengrep/releases/download/v${OPENGREP_VERSION}/opengrep_musllinux_${ARCH}" && \
    install -m 0755 /tmp/opengrep /usr/local/bin/opengrep && \
    rm -f /tmp/opengrep

# musllinux build → alpine base, matching every other Argus image. The
# previous debian-slim base carried the full Debian package surface
# (perl, util-linux, ncurses, …) whose no-fix-yet CVEs dominated our own
# base-image findings.
FROM python:3.14.8-alpine@sha256:f6a589d43c42b9e7f7dc67a12d37132491f362859a5d750607710cc56da3bc72

LABEL org.opencontainers.image.source="https://github.com/huntridge-labs/argus"
LABEL org.opencontainers.image.description="Argus OpenGrep SAST Scanner"
LABEL org.opencontainers.image.licenses="AGPL-3.0"

# Patch OS-level vulnerabilities before anything else
RUN apk upgrade --no-cache

# pip vendors certifi, so this pin decides the image's CA bundle. Same value
# in every Dockerfile (scripts/ci/check_tool_currency.py enforces it); Renovate
# bumps it under the 7-day release-age policy (ADR-043).
ARG PIP_VERSION=26.2.2
RUN pip install --no-cache-dir --upgrade "pip==${PIP_VERSION}"

COPY --from=builder /usr/local/bin/opengrep /usr/local/bin/opengrep

RUN adduser -D -u 1000 argus

USER argus
WORKDIR /workspace
ENTRYPOINT ["opengrep"]
