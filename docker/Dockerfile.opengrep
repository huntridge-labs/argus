FROM alpine:3.23.4@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11 AS builder

ARG OPENGREP_VERSION=1.22.0
ARG TARGETARCH

RUN apk add --no-cache curl && \
    if [ "$TARGETARCH" = "arm64" ]; then \
      ARCH="aarch64"; \
    else \
      ARCH="x86"; \
    fi && \
    curl -sSfL "https://github.com/opengrep/opengrep/releases/download/v${OPENGREP_VERSION}/opengrep_manylinux_${ARCH}" \
      -o /usr/local/bin/opengrep && \
    chmod +x /usr/local/bin/opengrep

FROM python:3.14.5-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97

LABEL org.opencontainers.image.source="https://github.com/huntridge-labs/argus"
LABEL org.opencontainers.image.description="Argus OpenGrep SAST Scanner"
LABEL org.opencontainers.image.licenses="AGPL-3.0"

# Patch OS-level vulnerabilities before anything else
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/opengrep /usr/local/bin/opengrep

RUN useradd -m -u 1000 argus

USER argus
WORKDIR /workspace
ENTRYPOINT ["opengrep"]
