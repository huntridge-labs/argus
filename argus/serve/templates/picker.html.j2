{% extends "base.html.j2" %}
{% block title %}Argus — Switch scan{% endblock %}
{% block content %}

<h2>Switch scan</h2>
<p style="color: var(--fg-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">
  Navigate into a folder that contains an <code>argus-results.json</code> and
  click <strong>Load this scan</strong>. Nested results show as scan-ready
  folders so you can pick a single run from a parent directory of scans.
</p>

<p class="crumbs" style="font-family: ui-monospace, monospace; background: var(--surface); padding: 0.5rem 0.75rem; border-radius: var(--radius); margin-bottom: 1rem;">
  {{ current }}
</p>

{% if error %}
  <div class="warnings">
    <h3>Error</h3>
    <p>{{ error }}</p>
  </div>
{% endif %}

<div style="display: flex; gap: 1rem; align-items: center; margin: 1rem 0; flex-wrap: wrap;">
  {%- if has_results -%}
    <a href="/?scan={{ current | urlencode }}"
       style="background: var(--accent); color: #0f1419; padding: 0.5rem 1rem; border-radius: var(--radius); text-decoration: none; font-weight: 600;">
      ▶ Load this scan
    </a>
    <span style="color: var(--fg-muted); font-size: 0.9rem;">
      <code>argus-results.json</code> detected here.
    </span>
  {% else %}
    <em style="color: var(--fg-muted);">No <code>argus-results.json</code> in this folder — click into a subfolder below, or type a path to jump.</em>
  {% endif -%}
</div>

<form method="get" action="/picker" style="display: flex; gap: 0.5rem; margin: 1rem 0; align-items: center;">
  <label style="flex: 1;">
    Jump to path:
    <input type="text" name="path" value="{{ current }}"
           style="width: 100%; padding: 0.4rem 0.6rem; background: var(--surface); color: var(--fg); border: 1px solid var(--border); border-radius: 4px;" />
  </label>
  <button type="submit">Go</button>
</form>

<table>
  <thead>
    <tr>
      <th style="width: 3rem;">Type</th>
      <th>Name</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    {%- if parent -%}
      <tr>
        <td>📁</td>
        <td><a href="/picker?path={{ parent | urlencode }}"><code>..</code></a></td>
        <td><em style="color: var(--fg-muted);">parent directory</em></td>
      </tr>
    {%- endif -%}

    {%- for entry in entries -%}
      <tr>
        <td>{%- if entry.is_dir -%}📁{%- else -%}📄{%- endif -%}</td>
        <td>
          {%- if entry.is_dir -%}
            <a href="/picker?path={{ entry.path | urlencode }}"><code>{{ entry.name }}/</code></a>
          {%- else -%}
            <code>{{ entry.name }}</code>
          {%- endif -%}
        </td>
        <td>
          {%- if entry.has_results -%}
            <a href="/?scan={{ entry.path | urlencode }}"
               style="color: var(--accent); font-weight: 600;">
              ▶ Load scan ({{ entry.finding_count }} finding{{ entry.finding_count != 1 and 's' or '' }})
            </a>
          {%- elif entry.is_results_file -%}
            <a href="/?scan={{ entry.path | urlencode }}"
               style="color: var(--accent); font-weight: 600;">
              ▶ Load scan
            </a>
          {%- else -%}
            <span style="color: var(--fg-muted);">—</span>
          {%- endif -%}
        </td>
      </tr>
    {%- endfor -%}

    {%- if not entries and not parent -%}
      <tr><td colspan="3"><em>Empty directory.</em></td></tr>
    {%- endif -%}
  </tbody>
</table>

<p style="color: var(--fg-muted); font-size: 0.85rem; margin-top: 1rem;">
  Dotfiles and common build dirs (<code>node_modules</code>, <code>.git</code>,
  <code>.venv</code>) are hidden by default.
  {%- if not show_hidden -%}
    <a href="/picker?path={{ current | urlencode }}&show_hidden=1">Show hidden</a>
  {%- else -%}
    <a href="/picker?path={{ current | urlencode }}">Hide hidden</a>
  {%- endif -%}
</p>

{% endblock %}
