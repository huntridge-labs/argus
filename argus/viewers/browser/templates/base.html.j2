{#-
  Base layout for every argus serve page.
  Intentionally minimal: header with nav + scan context, main content
  block, footer. Templates override only ``title`` and ``content``.
  CSP header is set by the FastAPI response; we add a meta tag as
  defense-in-depth for when users open a saved page offline.
-#}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="Content-Security-Policy"
        content="default-src 'self'; style-src 'self'; script-src 'self'" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}Argus{% endblock %}</title>
  <link rel="icon" type="image/png" href="/static/favicon.png" />
  <link rel="stylesheet" href="/static/argus.css" />
</head>
<body>
  <header>
    <a class="brand" href="/">
      <img src="/static/favicon.png" alt="" aria-hidden="true" />
      <h1>Project Argus</h1>
    </a>
    <nav>
      {#- Use a prefixed name so we don't collide with route-provided
          context vars (picker passes ``current`` for the filesystem
          path; plain ``current`` here would shadow it inside any
          child {% block content %} that references {{ current }}).  -#}
      {%- set _active_nav = request.url.path -%}
      <a href="/?{% if scan_param %}scan={{ scan_param | urlencode }}{% endif %}"
         {% if _active_nav == "/" %}aria-current="page"{% endif %}>Dashboard</a>
      <a href="/findings{% if scan_param %}?scan={{ scan_param | urlencode }}{% endif %}"
         {% if _active_nav == "/findings" %}aria-current="page"{% endif %}>Findings</a>
      <a href="/log{% if scan_param %}?scan={{ scan_param | urlencode }}{% endif %}"
         {% if _active_nav == "/log" %}aria-current="page"{% endif %}>Log</a>

      {#- Recent runs dropdown — only rendered when there are at
          least two scan-ready dirs under the launch root. Single-scan
          deployments (the common case for a one-off argus scan) get
          the plain nav without an empty dropdown. -#}
      {% if recent_scans and recent_scans | length > 1 %}
        <details class="recent-scans-menu">
          <summary>Recent runs <span class="recent-scans-count">{{ recent_scans | length }}</span></summary>
          <ul class="recent-scans-list">
            {% for s in recent_scans %}
              <li>
                <a href="/?scan={{ s.path | urlencode }}"
                   {% if s.is_current %}aria-current="true" class="recent-scans-current"{% endif %}>
                  <span class="recent-scans-label">{{ s.label }}</span>
                  <span class="recent-scans-count-badge">{{ s.count }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}

      <a href="/picker"
         {% if _active_nav == "/picker" %}aria-current="page"{% endif %}>Switch scan</a>

      {#- Theme toggle — flips between dark and light via a
          data-theme attribute on <html>. Defaults to the user's
          prefers-color-scheme until they click it, after which the
          choice persists in localStorage. Button label updates in
          JS; the SSR fallback reads "Theme" with no icon so users
          without JS see a clean no-op label rather than a broken one. -#}
      <button type="button" class="theme-toggle" id="theme-toggle"
              aria-label="Toggle color theme">
        <span class="theme-toggle-icon" aria-hidden="true">◐</span>
        <span class="theme-toggle-label sr-only">Theme</span>
      </button>
    </nav>
  </header>

  <main>
    {% if scan_label %}
      <p class="crumbs scan-crumbs">
        Scan: <code>{{ scan_label }}</code>
      </p>
    {% endif %}
    {% block content %}{% endblock %}
  </main>

  <footer>
    Generated by <a href="https://argus.huntridgelabs.com" rel="noopener">argus</a>
    · localhost-only ·
    <a href="/healthz">healthz</a>
  </footer>

  {#- Theme-toggle JS loaded at end-of-body with defer so the header
      renders without a flash. When localStorage already has a saved
      preference the script applies it here; otherwise the @media
      prefers-color-scheme rule in argus.css has already done the
      right thing. -#}
  <script src="/static/theme-toggle.js" defer></script>
</body>
</html>
