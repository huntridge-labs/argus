{% extends "base.html.j2" %}
{% block title %}Argus — Findings{% endblock %}
{% block content %}

{% if summary is none %}
  <section class="placeholder">
    <h2>No scan loaded</h2>
    {% if error %}<p><strong>Error:</strong> {{ error }}</p>{% endif %}
  </section>

{% else %}

  <h2>Findings</h2>

  {#- Filter bar. Every control is a plain GET form so the page stays
      bookmarkable and works without JS (the Apply button is the
      no-JS fallback). The ``data-auto-filter`` attribute opts this
      form into auto-filter.js, which swaps just the table body
      when JS is live. -#}
  <form method="get" action="/findings" data-auto-filter class="filter-bar">
    {%- if scan_param -%}
      <input type="hidden" name="scan" value="{{ scan_param }}" />
    {%- endif -%}

    <label>
      Min severity:
      <select name="min_severity">
        <option value=""          {% if not view.min_severity %}selected{% endif %}>(all)</option>
        <option value="critical"  {% if view.min_severity == "critical" %}selected{% endif %}>Critical only</option>
        <option value="high"      {% if view.min_severity == "high"     %}selected{% endif %}>High and above</option>
        <option value="medium"    {% if view.min_severity == "medium"   %}selected{% endif %}>Medium and above</option>
        <option value="low"       {% if view.min_severity == "low"      %}selected{% endif %}>Low and above</option>
      </select>
    </label>

    {% if products %}
      <label>
        Product:
        <select name="product">
          <option value="" {% if not view.product %}selected{% endif %}>(all)</option>
          {% for p in products %}
            <option value="{{ p }}" {% if view.product == p %}selected{% endif %}>{{ p }}</option>
          {% endfor %}
        </select>
      </label>
    {% endif %}

    {% if scanners %}
      <label>
        Scanner:
        <select name="scanner">
          <option value="" {% if not view.scanner %}selected{% endif %}>(all)</option>
          {% for s in scanners %}
            <option value="{{ s }}" {% if view.scanner == s %}selected{% endif %}>{{ s }}</option>
          {% endfor %}
        </select>
      </label>
    {% endif %}

    <label>
      Search:
      <input type="search" name="q" value="{{ view.query or '' }}"
             placeholder="id, title, CVE, scanner…" />
    </label>

    <button type="submit">Apply</button>
    <a href="/findings{% if scan_param %}?scan={{ scan_param | urlencode }}{% endif %}">Reset</a>
  </form>

  {% if severity_hint %}
    <p class="filter-hint" role="status">{{ severity_hint }}</p>
  {% endif %}

  {#- Export menu. Hrefs carry the currently active filter + sort query
      params so what the user exports is exactly what they see. Each
      format has two actions: download (browser writes to disk) and
      copy (small JS fetches the same URL and copies to clipboard). -#}
  {%- set export_query -%}
    {%- set params = [] -%}
    {%- if view.min_severity %}{% set _ = params.append('min_severity=' ~ (view.min_severity | urlencode)) %}{% endif -%}
    {%- if view.product %}{% set _ = params.append('product=' ~ (view.product | urlencode)) %}{% endif -%}
    {%- if view.scanner %}{% set _ = params.append('scanner=' ~ (view.scanner | urlencode)) %}{% endif -%}
    {%- if view.query %}{% set _ = params.append('q=' ~ (view.query | urlencode)) %}{% endif -%}
    {%- if view.sort %}{% set _ = params.append('sort=' ~ (view.sort | urlencode)) %}{% endif -%}
    {%- if scan_param %}{% set _ = params.append('scan=' ~ (scan_param | urlencode)) %}{% endif -%}
    {{- params | join('&') -}}
  {%- endset %}
  <details class="export-menu">
    <summary>Export</summary>
    <div class="export-grid">
      {%- for fmt, label in [('csv', 'CSV'), ('json', 'JSON'), ('markdown', 'Markdown'), ('sarif', 'SARIF')] -%}
        {%- set base_url = '/export?format=' ~ fmt ~ ('&' ~ export_query if export_query else '') -%}
        <div class="export-row">
          <span class="export-format">{{ label }}</span>
          <a class="export-action" href="{{ base_url }}&download=1">Download</a>
          <button type="button" class="export-action export-copy"
                  data-export-url="{{ base_url }}"
                  data-export-format="{{ fmt }}">Copy</button>
        </div>
      {%- endfor -%}
    </div>
    <p class="export-status" role="status" aria-live="polite"></p>
  </details>

  {#- Swap target for auto-filter.js. The JS replaces the contents
      of #findings-target; the plain-form fallback re-renders the
      whole page. Both code paths use the same _findings_table.html.j2
      partial so row markup stays in lockstep. -#}
  <div id="findings-target">
    {% include "_findings_table.html.j2" %}
  </div>

  <script src="/static/auto-filter.js" defer></script>
  <script src="/static/export-copy.js" defer></script>

{% endif %}

{% endblock %}
