#!/usr/bin/env python3
"""Argus CLI entry point — enables `argus` as a command and shell completions."""
import sys
from pathlib import Path

# Ensure the argus package is importable when running from the repo
repo_root = Path(__file__).resolve().parent.parent
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from argus.cli import main
main()
